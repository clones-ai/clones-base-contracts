# ===========================
# Local / Hardhat dev config
# ===========================

# Replace this with your own deployer key (must start with 0x and be 64 hex chars)
# DO NOT use dummy in production
DEPLOYER_KEY= # leave empty to use unlocked local accounts


# RPC endpoints
RPC_LOCAL=http://127.0.0.1:8545
RPC_BASE_SEPOLIA=
RPC_BASE=

# Etherscan-style API key (optional for verification)
BASESCAN_KEY=

# Treasury & fees
PROTOCOL_FEE_RECIPIENT= #leave empty on local (defaults to deployer)
CREATOR_FEE_RECIPIENT=

# Uniswap V2 router addresses (Base / Base Sepolia)
UNISWAP_V2_ROUTER_BASE=
UNISWAP_V2_ROUTER_BASE_SEPOLIA=

# Chainlink ETH/USD price feeds
CHAINLINK_ETH_USD_BASE=
CHAINLINK_ETH_USD_BASE_SEPOLIA=

# Ownership defaults
REGISTRY_OWNER=
BURN_PORTAL_OWNER=

# For deploy scripts
FACTORY=
REGISTRY=
BURN_PORTAL=

# Optional: IPFS pinning
IPFS_GATEWAY=

# Mongo (for metadata API)
MONGODB_URI=
MONGODB_DB=